# 값은 .env 에만 넣는다 (.env 는 gitignore 대상). 이 파일에는 변수 이름만 둔다.
# B 전용 키를 쓴다(A 키와 섞지 않는다). 비용 상한은 .env가 아니라 코드 설정으로 고정한다(ADR-007).

# 에이전트 주 모델 (LiteLLM 경유)
OPENAI_API_KEY=
# fallback 모델, Guardrail v2 분류기 (LiteLLM 경유)
ANTHROPIC_API_KEY=
# 답변 채점 (게이트웨이 미경유)
GEMINI_API_KEY=

# A MCP 서버 주소 (live 모드). 예: http://127.0.0.1:8765/mcp
KODOCS_MCP_URL=
# A 사용자별 토큰 파일의 절대 경로. 자격 증명 중개(broker)만 실행 시 읽는다. 파일은 열거나 출력하지 않는다.
KODOCS_MCP_TOKENS_FILE=

# LiteLLM·Postgres 변수 이름은 아래에 추가했다. Langfuse 변수는 M0 obs step에서 추가된다.

# Postgres 인스턴스 초기화 사용자
POSTGRES_USER=
# Postgres 인스턴스 초기화 비밀번호
POSTGRES_PASSWORD=
# LiteLLM 프록시 관리 키
LITELLM_MASTER_KEY=
# LiteLLM 전용 DB 연결 URL (compose 내부 postgres의 litellm DB)
LITELLM_DATABASE_URL=
