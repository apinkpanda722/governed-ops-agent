# 값은 .env 에만 넣는다 (.env 는 gitignore 대상). 이 파일에는 변수 이름만 둔다.
# B 전용 키를 쓴다(A 키와 섞지 않는다). 비용 상한은 .env가 아니라 코드 설정으로 고정한다(ADR-007).

# 에이전트 주 모델 (LiteLLM 경유)
OPENAI_API_KEY=
# fallback claude-sonnet-5-5, Guardrail v2 분류기 (LiteLLM 경유, ADR-019)
ANTHROPIC_API_KEY=
# 답변 채점 (게이트웨이 미경유)
GEMINI_API_KEY=

# A MCP 서버 주소 (live 모드). 예: http://127.0.0.1:8765/mcp
KODOCS_MCP_URL=
# A 사용자별 토큰 파일의 절대 경로. 자격 증명 중개(broker)만 실행 시 읽는다. 파일은 열거나 출력하지 않는다.
KODOCS_MCP_TOKENS_FILE=
# mock 사용자별 토큰 파일 경로 (기본 data/interim/mock/tokens.json)
MOCK_TOKENS_FILE=

# LiteLLM·Postgres 변수 이름은 아래에 추가했다. Langfuse 변수는 M0 obs step에서 추가된다.

# Postgres 인스턴스 초기화 사용자
POSTGRES_USER=
# Postgres 인스턴스 초기화 비밀번호
POSTGRES_PASSWORD=
# LiteLLM 프록시 관리 키
LITELLM_MASTER_KEY=
# LiteLLM 전용 DB 연결 URL (compose 내부 postgres의 litellm DB)
LITELLM_DATABASE_URL=

# Langfuse web 세션 서명 비밀 (profile obs)
NEXTAUTH_SECRET=
# Langfuse 해시용 salt (profile obs)
SALT=
# Langfuse 암호화 키 (profile obs, 형식은 첫 기동 전 공식 문서 확인)
ENCRYPTION_KEY=
# Langfuse·ClickHouse 공통 접속 사용자 (profile obs)
CLICKHOUSE_USER=
# Langfuse·ClickHouse 공통 접속 비밀번호 (profile obs)
CLICKHOUSE_PASSWORD=
# Langfuse·Redis 공통 인증 비밀번호 (profile obs)
REDIS_AUTH=
# MinIO 루트 사용자 및 Langfuse S3 접근 키 ID (profile obs)
MINIO_ROOT_USER=
# MinIO 루트 비밀번호 및 Langfuse S3 비밀 접근 키 (profile obs)
MINIO_ROOT_PASSWORD=

# mock-slack 해시 매니페스트 경로 재정의 (기본 data/seed/mock_slack_token_hashes.json)
MOCK_SLACK_TOKEN_HASHES=

# 진단 전용(Guardrail은 팀 없는 키를 `team_unknown`으로 막는다). 서비스 경로는 쓰지 않는다
LITELLM_AGENT_KEY=
# 호스트의 에이전트가 호출하는 LiteLLM 주소. 값 형식: http://127.0.0.1:4000
LITELLM_BASE_URL=
# 호스트의 에이전트가 쓰는 checkpointer DB 연결. 값 형식: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:5432/govops
# 호스트에서 접속하므로 127.0.0.1이다(컨테이너용 LITELLM_DATABASE_URL의 호스트 postgres와 다르다)
GOVOPS_DATABASE_URL=
# make test-outbox-pg 전용 DB 연결. 값 형식은 GOVOPS_DATABASE_URL과 같다. 테스트가 무작위 이름의 임시 테이블만 만들고 지우므로 govops DB를 그대로 써도 된다
GOVOPS_TEST_DATABASE_URL=
# 데모 로그인 플래그. 값 형식: true (true일 때만 POST /sessions가 열리고 127.0.0.1에만 바인드한다)
DEMO_LOGIN=
# 호스트의 mock-jira REST 주소 (비어 있으면 http://127.0.0.1:8081)
MOCK_JIRA_URL=
# 호스트의 mock-slack REST 주소 (비어 있으면 http://127.0.0.1:8082)
MOCK_SLACK_URL=

# Langfuse 첫 기동 후 UI에서 프로젝트·API 키를 만들어 .env에 넣는다
# 호스트 에이전트 주소 형식: http://127.0.0.1:3000
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 사용자 실행 obs-up이 설정 파일을 선택한다(비어 있으면 기본 설정)
LITELLM_CONFIG_FILE=

# dev 실행 매니페스트에 기록할 live A 인덱스 이름. 형식: kodocs-m5-{condition}-{chunking}
# (예: kodocs-m5-composite-structural). 러너는 A_ROOT/src/kodocs/tools/deps.py의 TOOL_INDEX(A MCP 서버가
# 쓰는 값)를 읽기 전용으로 우선 기록하고, 읽을 수 없을 때만 이 값을 쓴다(출처: index_name_source).
KODOCS_INDEX_NAME=

# 감사 JSONL 저장 디렉토리 (기본 data/interim/audit/)
AUDIT_DIR=
# 감사 Ed25519 키 경로 (비워 두면 개인키 data/interim/audit_ed25519.pem,
# 공개키 data/seed/audit_public_key.pem 사용)
AUDIT_KEY_FILE=
AUDIT_PUBLIC_KEY_FILE=

# 에이전트 프로필: writes_team(기본, 요청자 팀·발송 정책 포함·승인 후 부작용 실행), writes_org(동결)
GOVOPS_AGENT_PROFILE=

# Guardrail v2 호스트 수집 지점 분류: on|off, 미설정·빈 값은 off. 기록 재생·CI는 off 고정(ADR-026)
GOVOPS_GUARDRAIL_V2=

# 하네스 전용: down_alias, 일반 서비스에서는 비워 둔다(설정 시 시작 거부)
GOVOPS_MODEL_FAULT_MODE=

# 서비스 경로의 팀별 LiteLLM 가상 키. 사용자 실행 make team-keys로 발급
LITELLM_TEAM_KEY_DATA_AI=
LITELLM_TEAM_KEY_FINANCE=
LITELLM_TEAM_KEY_HR=
LITELLM_TEAM_KEY_LEGAL=
LITELLM_TEAM_KEY_PAYMENTS=
LITELLM_TEAM_KEY_PLATFORM=
LITELLM_TEAM_KEY_SECURITY=
LITELLM_TEAM_KEY_SRE=

# 감사 고정점 대기 파일 (비우면 data/interim/audit/anchors-pending.jsonl)
AUDIT_ANCHORS_PENDING_FILE=

# 탐색 루프 차단 플래그: 빈 값·1은 등록값 N=4로 켬, 0은 끔(비용 상한 아님).
GOVOPS_EXPLORATION_BUDGET=
